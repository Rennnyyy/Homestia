<Project>
  <!-- ══════════════════════════════════════════════════════════════════════════
       Homestia build settings — self-contained (no longer imports the sibling
       Aletheia repo). The Aletheia SDK is consumed as NuGet packages from the
       GitHub Packages feed (see ../nuget.config + Directory.Packages.props).
       ══════════════════════════════════════════════════════════════════════════ -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <!-- AngleSharp transitive dependency via dotNetRDF has a known moderate vulnerability. -->
    <NoWarn>$(NoWarn);NU1902</NoWarn>
    <!-- NU1507: multiple feeds (nuget.org + github, and the local folder feed in
         scripts/build-local.sh) are intentional under central package management.
         Package source mapping would break the local folder-feed restore
         (-s <feed> is not a mapping key), so the advisory warning is suppressed. -->
    <NoWarn>$(NoWarn);NU1507</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Aletheia SDK version consumed from the GitHub Packages feed — the single
         source of truth: Directory.Packages.props drives every Aletheia.Sdk.*
         package version from this property, so an upgrade is one edit here.
         Must match a published package version (e.g. 0.9.5). Override locally
         with -p:AletheiaSdkVersion=... (see scripts/build-local.sh).
         NOTE: NuGet floating versions are NOT supported under central package
         management. The pin is deliberate — there is no version resolution. -->
    <AletheiaSdkVersion>0.9.7-rc.e986cf7</AletheiaSdkVersion>
  </PropertyGroup>
</Project>
