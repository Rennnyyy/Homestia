classDiagram
    direction TB

    %% ── CORE: Aletheia.Authentication.Agent (from Aletheia core — NOT our code) ──
    class Agent {
        <<Aletheia.Authentication>>
    }

    %% ── ENUMS ───────────────────────────────────────────────────
    class PropertyType {
        <<enumeration>>
        Apartment
        Studio
    }

    class RentalModel {
        <<enumeration>>
        EntireProperty
        SingleRoomRentalSharedLiving
    }

    class FurnishingStatus {
        <<enumeration>>
        Unfurnished
        PartiallyFurnished
        FullyFurnished
    }

    class RoomStatus {
        <<enumeration>>
        Available
        Reserved
        ActivelyRented
        Blocked
    }

    %% ── AGGREGATE: RealEstate ───────────────────────────────────
    class Landlord {
        +ID : Guid
    }

    class Property {
        +ID : Guid
        +Name : string
        +PropertyType : PropertyType
        +RentalModel : RentalModel
    }

    %% ── ABSTRACTION: Segmentation ───────────────────────────────
    class Segmentation {
        <<abstract>>
        +ID : Guid
        +Name : string
        +IsCommonArea : bool
    }

    class Room {
        +FurnishingStatus : FurnishingStatus
        +RoomStatus : RoomStatus
    }

    class Studio {
    }

    %% ── AGGREGATE: Inventory ────────────────────────────────────
    class InventoryItem {
        +ID : Guid
        +Name : string
    }

    %% ── RELATIONSHIPS ───────────────────────────────────────────
    Landlord "1" --> "n" Property : owns
    Segmentation <|-- Property
    Segmentation <|-- Room
    Segmentation <|-- Studio
    Segmentation "1" --> "n" Segmentation : segments into
    Segmentation "1" --> "n" InventoryItem : is equipped with

    Landlord "n" --> "n" Agent : represented by

    Property --> PropertyType : classified as
    Property --> RentalModel : rented as
    Room --> FurnishingStatus : furnished as
    Room --> RoomStatus : has rental status

    %% ── STYLING ─────────────────────────────────────────────────
    style Agent fill:#fff3cd,stroke:#f0ad4e,stroke-width:2px,color:#856404
