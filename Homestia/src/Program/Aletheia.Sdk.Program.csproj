<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- ══════════════════════════════════════════════════════════════════════════
       Auto-rebuild Angular into wwwroot on every dotnet run / build.
       Skip with: dotnet run -p:SkipAngularBuild=true
       ══════════════════════════════════════════════════════════════════════════ -->
  <Target Name="BuildAngularFrontend" BeforeTargets="BeforeBuild"
          Condition="'$(SkipAngularBuild)' != 'true'">
    <PropertyGroup>
      <WebDir>$(MSBuildProjectDirectory)/../Web/App</WebDir>
      <WwwRootDir>$(MSBuildProjectDirectory)/wwwroot</WwwRootDir>
    </PropertyGroup>

    <!-- Pre-flight: Node.js must be available -->
    <Exec Command="node --version"
          ContinueOnError="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="_NodeExitCode" />
    </Exec>
    <Error Condition="'$(_NodeExitCode)' != '0'"
           Text="Node.js is not installed or not on PATH. Install Node.js 22+ from https://nodejs.org and retry.&#xA;Or skip the Angular build with: dotnet build -p:SkipAngularBuild=true" />

    <!-- Capture load-time wwwroot Content items BEFORE deleting the folder.
         MSBuild's Remove glob expands against the filesystem, so it cannot
         remove items whose files no longer exist — capture identities first
         and remove them exactly after the Angular build regenerates wwwroot. -->
    <ItemGroup>
      <_StaleWwwrootContent Include="@(Content)" Condition="$([System.String]::Copy('%(Identity)').StartsWith('wwwroot'))" />
    </ItemGroup>

    <!-- Clean old wwwroot output and ALL static web assets cache files.
         The SDK caches paths in obj/*/staticwebassets* — stale entries cause
         intermittent resolution failures during publish. -->
    <RemoveDir Directories="$(WwwRootDir)" Condition="Exists('$(WwwRootDir)')" />
    <MakeDir Directories="$(WwwRootDir)" />
    <RemoveDir Directories="$(MSBuildProjectDirectory)/obj/$(Configuration)/$(TargetFramework)/staticwebassets" />
    <ItemGroup>
      <_StaleAssetManifests Include="$(MSBuildProjectDirectory)/obj/$(Configuration)/$(TargetFramework)/staticwebassets*;
                                   $(MSBuildProjectDirectory)/obj/$(Configuration)/$(TargetFramework)/*.dswa.cache.json;
                                   $(MSBuildProjectDirectory)/obj/$(Configuration)/$(TargetFramework)/swae*" />
    </ItemGroup>
    <Delete Files="@(_StaleAssetManifests)" />

    <Message Importance="high" Text="──────────────────────────────────────────────" />
    <Message Importance="high" Text="🔨 Building Angular frontend..." />
    <Message Importance="high" Text="   Source : $(WebDir)" />
    <Message Importance="high" Text="   Output : $(WwwRootDir)" />
    <Message Importance="high" Text="──────────────────────────────────────────────" />

    <!-- Restore: npm ci when lock file exists (CI / reproducible), npm install otherwise -->
    <Exec Command="npm ci" WorkingDirectory="$(WebDir)"
          Condition="Exists('$(WebDir)/package-lock.json')" />
    <Exec Command="npm install" WorkingDirectory="$(WebDir)"
          Condition="!Exists('$(WebDir)/package-lock.json') And Exists('$(WebDir)/package.json')" />

    <!-- npm run build: the prebuild hook generates src/generated/tailwind.css
         (required by angular.json global styles), then runs ng build. Output
         goes to wwwroot/ per angular.json outputPath. -->
    <Exec Command="npm run build -- --configuration production"
          WorkingDirectory="$(WebDir)"
          Condition="Exists('$(WebDir)/package.json')" />

    <!-- Angular 19+ outputs to a browser/ subdirectory; Program.cs serves
         wwwroot/browser/ directly via the web root — no flattening needed.

         Refresh Content items here: the SDK globs wwwroot/** into @(Content)
         at project load — BEFORE this target runs. Re-declaring them after the
         Angular build ensures dotnet publish copies the fresh files and
         DefineStaticWebAssets resolves current paths (avoids stale references
         when Angular emits new hashed chunk filenames). -->
    <ItemGroup>
      <Content Remove="@(_StaleWwwrootContent)" />
      <Content Include="wwwroot/**"
               ExcludeFromSingleFile="true"
               CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <Message Importance="high" Text="✅ Angular build complete." />
  </Target>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Aletheia.Sdk.Program</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Program slices — Capabilities and Entities are separate projects.
    The Program host wires them together, hosts the view registrations,
    and serves HTTP.
  -->
  <ItemGroup>
    <ProjectReference Include="../Capabilities/Aletheia.Sdk.Program.Capabilities.csproj" />
    <ProjectReference Include="../Entities/Aletheia.Sdk.Program.Entities.csproj" />
  </ItemGroup>

  <!--
    Aletheia SDK — host-level slices needed for HTTP wiring.
  -->
  <ItemGroup>
    <ProjectReference Include="../../../../Aletheia/SDK/src/Aspects/Aletheia.Sdk.Aspects.csproj" />
    <ProjectReference Include="../../../../Aletheia/SDK/src/Aspects.Abstractions/Aletheia.Sdk.Aspects.Abstractions.csproj" />
    <ProjectReference Include="../../../../Aletheia/SDK/src/Aspects.Entity/Aletheia.Sdk.Aspects.Entity.csproj" />
    <ProjectReference Include="../../../../Aletheia/SDK/src/Authorization/Aletheia.Sdk.Authorization.csproj" />
    <ProjectReference Include="../../../../Aletheia/SDK/src/Authorization.Entity/Aletheia.Sdk.Authorization.Entity.csproj" />
    <ProjectReference Include="../../../../Aletheia/SDK/src/Authorization.Http/Aletheia.Sdk.Authorization.Http.csproj" />
    <ProjectReference Include="../../../../Aletheia/SDK/src/Branch/Aletheia.Sdk.Branch.csproj" />
    <ProjectReference Include="../../../../Aletheia/SDK/src/Branch.Http/Aletheia.Sdk.Branch.Http.csproj" />
    <ProjectReference Include="../../../../Aletheia/SDK/src/Capability/Aletheia.Sdk.Capability.csproj" />
    <ProjectReference Include="../../../../Aletheia/SDK/src/Capability.Entity/Aletheia.Sdk.Capability.Entity.csproj" />
    <ProjectReference Include="../../../../Aletheia/SDK/src/Capability.Http/Aletheia.Sdk.Capability.Http.csproj" />
    <ProjectReference Include="../../../../Aletheia/SDK/src/Capability.Messaging/Aletheia.Sdk.Capability.Messaging.csproj" />
    <ProjectReference Include="../../../../Aletheia/SDK/src/Entity/Aletheia.Sdk.Entity.csproj" />
    <ProjectReference Include="../../../../Aletheia/SDK/src/Entity.Entity/Aletheia.Sdk.Entity.Entity.csproj" />
    <ProjectReference Include="../../../../Aletheia/SDK/src/Entity.Messaging/Aletheia.Sdk.Entity.Messaging.csproj" />
    <ProjectReference Include="../../../../Aletheia/SDK/src/Execution/Aletheia.Sdk.Execution.csproj" />
    <ProjectReference Include="../../../../Aletheia/SDK/src/ObjectStorage/Aletheia.Sdk.ObjectStorage.csproj" />
    <ProjectReference Include="../../../../Aletheia/SDK/src/ObjectStorage.Http/Aletheia.Sdk.ObjectStorage.Http.csproj" />
    <ProjectReference Include="../../../../Aletheia/SDK/src/Messaging/Aletheia.Sdk.Messaging.csproj" />
    <ProjectReference Include="../../../../Aletheia/SDK/src/Messaging.InMemory/Aletheia.Sdk.Messaging.InMemory.csproj" />
    <ProjectReference Include="../../../../Aletheia/SDK/src/ObjectStorage.InMemory/Aletheia.Sdk.ObjectStorage.InMemory.csproj" />
    <ProjectReference Include="../../../../Aletheia/SDK/src/Operations/Aletheia.Sdk.Operations.csproj" />
    <ProjectReference Include="../../../../Aletheia/SDK/src/Operations.Http/Aletheia.Sdk.Operations.Http.csproj" />
    <ProjectReference Include="../../../../Aletheia/SDK/src/Repository/Aletheia.Sdk.Repository.csproj" />
    <ProjectReference Include="../../../../Aletheia/SDK/src/Repository.InMemory/Aletheia.Sdk.Repository.InMemory.csproj" />
    <ProjectReference Include="../../../../Aletheia/SDK/src/Structure/Aletheia.Sdk.Structure.csproj" />
  </ItemGroup>

</Project>
