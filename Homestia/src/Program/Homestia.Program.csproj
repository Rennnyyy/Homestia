<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- ══════════════════════════════════════════════════════════════════════════
       Angular facade build lives in the Web slice (src/Web/build/Homestia.Web.targets),
       imported here so the facade is rebuilt into THIS host's wwwroot on every
       dotnet build / publish. Skip with: dotnet run -p:SkipAngularBuild=true
       ══════════════════════════════════════════════════════════════════════════ -->
  <Import Project="../Web/build/Homestia.Web.targets" />

  <!-- ══════════════════════════════════════════════════════════════════════════
       Sdk.Web admin → /aletheia/
       Aletheia.Sdk.Web copies its wwwroot into OUR output as wwwroot/, which
       would collide with the Homestia facade (both ship browser/index.html).
       We strip that copy and re-emit the admin into a dedicated
       aletheia-wwwroot/ folder (output + publish) that Program.cs serves at
       /aletheia/ — the same admin Sdk.Sample exposes via AddWebInterface.
       ══════════════════════════════════════════════════════════════════════════ -->
  <PropertyGroup>
    <SdkWebAdminSource>$(MSBuildThisFileDirectory)../../../../Aletheia/SDK/src/Web/wwwroot</SdkWebAdminSource>
  </PropertyGroup>

  <!-- Dedicated content: glob the compiled Sdk.Web admin at load and redirect it
       into aletheia-wwwroot/ (never wwwroot/). -->
  <ItemGroup Condition="Exists('$(SdkWebAdminSource)')">
    <Content Include="$(SdkWebAdminSource)/**/*"
             Link="aletheia-wwwroot/%(RecursiveDir)%(Filename)%(Extension)"
             ExcludeFromSingleFile="true"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Strip the Sdk.Web wwwroot from the output-copy AND publish item lists so it
       never lands in wwwroot/ and overwrites the Homestia facade's
       browser/index.html.
       The publish copy target (_CopyResolvedFilesToPublishPreserveNewest) copies
       @(_ResolvedFileToPublishPreserveNewest), which _ComputeResolvedFilesToPublishTypes
       computes from @(ResolvedFileToPublish). That split target runs AFTER
       ComputeResolvedFilesToPublishList has populated ResolvedFileToPublish, so
       hooking AfterTargets on the SPLIT target strips the Sdk.Web items at the
       exact moment the copy inputs are finalized. We remove them everywhere,
       keyed on the Sdk.Web source path, and only for items that would publish to
       wwwroot/ — the dedicated aletheia-wwwroot/ copy (same source path,
       different relative path) is kept. The facade's own wwwroot items come from
       the Homestia source tree and are never touched. -->
  <Target Name="RedirectSdkWebAdmin" AfterTargets="_ComputeResolvedFilesToPublishTypes">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="$([System.String]::Copy('%(Identity)').Contains('/Aletheia/SDK/src/Web/wwwroot'))
                                       And $([System.String]::Copy('%(RelativePath)').StartsWith('wwwroot/'))" />
      <_ResolvedFileToPublishPreserveNewest Remove="@(_ResolvedFileToPublishPreserveNewest)"
                                            Condition="$([System.String]::Copy('%(Identity)').Contains('/Aletheia/SDK/src/Web/wwwroot'))
                                                      And $([System.String]::Copy('%(RelativePath)').StartsWith('wwwroot/'))" />
      <_ResolvedFileToPublishAlways Remove="@(_ResolvedFileToPublishAlways)"
                                    Condition="$([System.String]::Copy('%(Identity)').Contains('/Aletheia/SDK/src/Web/wwwroot'))
                                              And $([System.String]::Copy('%(RelativePath)').StartsWith('wwwroot/'))" />
    </ItemGroup>
  </Target>

  <!-- Build-side strip: keep the Sdk.Web content out of the normal build output
       (bin/wwwroot) too. Hooked after GetCopyToOutputDirectoryItems populates the
       copy lists. -->
  <Target Name="StripSdkWebFromBuildOutput" AfterTargets="GetCopyToOutputDirectoryItems">
    <ItemGroup>
      <ContentWithTargetPath Remove="@(ContentWithTargetPath)"
                             Condition="$([System.String]::Copy('%(TargetPath)').StartsWith('wwwroot'))" />
      <_SourceItemsToCopyToOutputDirectory Remove="@(_SourceItemsToCopyToOutputDirectory)"
                                           Condition="$([System.String]::Copy('%(TargetPath)').StartsWith('wwwroot'))" />
      <_ResolvedCopyLocalPublishAssets Remove="@(_ResolvedCopyLocalPublishAssets)"
                                       Condition="$([System.String]::Copy('%(Identity)').Contains('/Aletheia/SDK/src/Web/wwwroot'))" />
    </ItemGroup>
  </Target>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Homestia</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Program slices — Capabilities and Entities are separate projects.
    The Program host wires them together, hosts the view registrations,
    and serves HTTP.
  -->
  <ItemGroup>
    <ProjectReference Include="../Capabilities/Homestia.Capabilities.csproj" />
    <ProjectReference Include="../Entities/Homestia.Entities.csproj" />
    <ProjectReference Include="../Web/Homestia.Web.csproj" />
  </ItemGroup>

  <!--
    Aletheia SDK — host-level slices needed for HTTP wiring.
  -->
  <ItemGroup>
    <ProjectReference Include="../../../../Aletheia/SDK/src/AI/Aletheia.Sdk.AI.csproj" />
    <ProjectReference Include="../../../../Aletheia/SDK/src/AI.Http/Aletheia.Sdk.AI.Http.csproj" />
    <ProjectReference Include="../../../../Aletheia/SDK/src/Aspects/Aletheia.Sdk.Aspects.csproj" />
    <ProjectReference Include="../../../../Aletheia/SDK/src/Aspects.Abstractions/Aletheia.Sdk.Aspects.Abstractions.csproj" />
    <ProjectReference Include="../../../../Aletheia/SDK/src/Aspects.Entity/Aletheia.Sdk.Aspects.Entity.csproj" />
    <ProjectReference Include="../../../../Aletheia/SDK/src/Authorization/Aletheia.Sdk.Authorization.csproj" />
    <ProjectReference Include="../../../../Aletheia/SDK/src/Authorization.Entity/Aletheia.Sdk.Authorization.Entity.csproj" />
    <ProjectReference Include="../../../../Aletheia/SDK/src/Authorization.Http/Aletheia.Sdk.Authorization.Http.csproj" />
    <ProjectReference Include="../../../../Aletheia/SDK/src/Branch/Aletheia.Sdk.Branch.csproj" />
    <ProjectReference Include="../../../../Aletheia/SDK/src/Branch.Http/Aletheia.Sdk.Branch.Http.csproj" />
    <ProjectReference Include="../../../../Aletheia/SDK/src/Capability/Aletheia.Sdk.Capability.csproj" />
    <ProjectReference Include="../../../../Aletheia/SDK/src/Capability.Entity/Aletheia.Sdk.Capability.Entity.csproj" />
    <ProjectReference Include="../../../../Aletheia/SDK/src/Capability.Http/Aletheia.Sdk.Capability.Http.csproj" />
    <ProjectReference Include="../../../../Aletheia/SDK/src/Capability.Messaging/Aletheia.Sdk.Capability.Messaging.csproj" />
    <ProjectReference Include="../../../../Aletheia/SDK/src/Entity/Aletheia.Sdk.Entity.csproj" />
    <ProjectReference Include="../../../../Aletheia/SDK/src/Entity.Entity/Aletheia.Sdk.Entity.Entity.csproj" />
    <ProjectReference Include="../../../../Aletheia/SDK/src/Entity.Messaging/Aletheia.Sdk.Entity.Messaging.csproj" />
    <ProjectReference Include="../../../../Aletheia/SDK/src/Execution/Aletheia.Sdk.Execution.csproj" />
    <ProjectReference Include="../../../../Aletheia/SDK/src/ObjectStorage/Aletheia.Sdk.ObjectStorage.csproj" />
    <ProjectReference Include="../../../../Aletheia/SDK/src/ObjectStorage.Http/Aletheia.Sdk.ObjectStorage.Http.csproj" />
    <ProjectReference Include="../../../../Aletheia/SDK/src/Messaging/Aletheia.Sdk.Messaging.csproj" />
    <ProjectReference Include="../../../../Aletheia/SDK/src/Messaging.InMemory/Aletheia.Sdk.Messaging.InMemory.csproj" />
    <ProjectReference Include="../../../../Aletheia/SDK/src/ObjectStorage.InMemory/Aletheia.Sdk.ObjectStorage.InMemory.csproj" />
    <ProjectReference Include="../../../../Aletheia/SDK/src/Operations/Aletheia.Sdk.Operations.csproj" />
    <ProjectReference Include="../../../../Aletheia/SDK/src/Operations.Http/Aletheia.Sdk.Operations.Http.csproj" />
    <ProjectReference Include="../../../../Aletheia/SDK/src/Repository/Aletheia.Sdk.Repository.csproj" />
    <ProjectReference Include="../../../../Aletheia/SDK/src/Repository.InMemory/Aletheia.Sdk.Repository.InMemory.csproj" />
    <ProjectReference Include="../../../../Aletheia/SDK/src/Structure/Aletheia.Sdk.Structure.csproj" />
    <ProjectReference Include="../../../../Aletheia/SDK/src/Web/Aletheia.Sdk.Web.csproj" />
  </ItemGroup>

</Project>
