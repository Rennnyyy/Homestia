<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- ══════════════════════════════════════════════════════════════════════════
       Angular facade build lives in the Web slice (src/Web/build/Homestia.Web.targets),
       imported here so the facade is rebuilt into THIS host's wwwroot on every
       dotnet build / publish. Skip with: dotnet run -p:SkipAngularBuild=true
       ══════════════════════════════════════════════════════════════════════════ -->
  <Import Project="../Web/build/Homestia.Web.targets" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Homestia</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Program slices — Capabilities and Entities are separate projects.
    The Program host wires them together, hosts the view registrations,
    and serves HTTP.
  -->
  <ItemGroup>
    <ProjectReference Include="../Capabilities/Homestia.Capabilities.csproj" />
    <ProjectReference Include="../Entities/Homestia.Entities.csproj" />
    <ProjectReference Include="../Web/Homestia.Web.csproj" />
  </ItemGroup>

  <!--
    Aletheia SDK — host-level slices needed for HTTP wiring.
  -->
  <ItemGroup>
    <PackageReference Include="Aletheia.Sdk.AI" />
    <PackageReference Include="Aletheia.Sdk.AI.Http" />
    <PackageReference Include="Aletheia.Sdk.Aspects" />
    <PackageReference Include="Aletheia.Sdk.Aspects.Abstractions" />
    <PackageReference Include="Aletheia.Sdk.Aspects.Entity" />
    <PackageReference Include="Aletheia.Sdk.Authorization" />
    <PackageReference Include="Aletheia.Sdk.Authorization.Entity" />
    <PackageReference Include="Aletheia.Sdk.Authorization.Http" />
    <PackageReference Include="Aletheia.Sdk.Branch" />
    <PackageReference Include="Aletheia.Sdk.Branch.Http" />
    <PackageReference Include="Aletheia.Sdk.Capability" />
    <PackageReference Include="Aletheia.Sdk.Capability.Entity" />
    <PackageReference Include="Aletheia.Sdk.Capability.Http" />
    <PackageReference Include="Aletheia.Sdk.Capability.Messaging" />
    <PackageReference Include="Aletheia.Sdk.Entity" />
    <PackageReference Include="Aletheia.Sdk.Entity.Entity" />
    <PackageReference Include="Aletheia.Sdk.Entity.Messaging" />
    <PackageReference Include="Aletheia.Sdk.Execution" />
    <PackageReference Include="Aletheia.Sdk.ObjectStorage" />
    <PackageReference Include="Aletheia.Sdk.ObjectStorage.Http" />
    <PackageReference Include="Aletheia.Sdk.Messaging" />
    <PackageReference Include="Aletheia.Sdk.Messaging.InMemory" />
    <PackageReference Include="Aletheia.Sdk.ObjectStorage.InMemory" />
    <PackageReference Include="Aletheia.Sdk.Operations" />
    <PackageReference Include="Aletheia.Sdk.Operations.Http" />
    <PackageReference Include="Aletheia.Sdk.Repository" />
    <PackageReference Include="Aletheia.Sdk.Repository.InMemory" />
    <PackageReference Include="Aletheia.Sdk.Repository.GraphDb" />
    <PackageReference Include="Aletheia.Sdk.Structure" />
    <PackageReference Include="Aletheia.Sdk.Web" />
  </ItemGroup>

</Project>
