{
  "name": "spartan",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "tailwind:build": "npx @tailwindcss/cli --input src/tailwind-input.css --output src/generated/tailwind.css",
    "tailwind:watch": "npx @tailwindcss/cli --input src/tailwind-input.css --output src/generated/tailwind.css --watch",
    "prestart": "npm run tailwind:build",
    "start": "ng serve",
    "prebuild": "npm run tailwind:build",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "generate-entities": "node scripts/generate-entities.mjs",
    "generate-entities:full": "node scripts/generate-entities.mjs --with-enum-values"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/animations": "^22.1.1",
    "@angular/cdk": "22.0.0",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@jsverse/transloco": "^8.4.0",
    "@lucide/angular": "^1.31.0",
    "@ng-icons/core": ">=32.0.0 <34.0.0",
    "@ng-icons/lucide": ">=32.0.0 <34.0.0",
    "@spartan-ng/brain": "^1.3.1",
    "@spartan-ng/cli": "^1.3.1",
    "@tailwindcss/cli": "^4.3.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "n3": "^2.2.0",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "@types/n3": "^1.26.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
