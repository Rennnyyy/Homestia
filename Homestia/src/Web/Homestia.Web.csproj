<Project Sdk="Microsoft.NET.Sdk">

  <!-- ══════════════════════════════════════════════════════════════════════════
       Homestia Web slice — hosts the Angular facade.
       Provides the web-root path (HomestiaWebPaths) and the facade serving
       pipeline (UseHomestiaWeb). The Angular build hook lives in
       build/Homestia.Web.targets, imported by the Program host.
       ══════════════════════════════════════════════════════════════════════════ -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Homestia.Web</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- The Angular source lives in the sibling Homestia.Frontend workspace at
         the repo root, outside this project — nothing to exclude here. -->
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
