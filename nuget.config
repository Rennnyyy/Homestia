<?xml version="1.0" encoding="utf-8"?>
<!--
  Homestia NuGet sources.

  nuget.org  - third-party packages.
  github     - Aletheia SDK packages (Aletheia.Sdk.*), published to the GitHub
               Packages feed of the Aletheia repository
               (nuget.pkg.github.com/rennnyyy).

  If the Aletheia packages are PUBLIC, no credentials are needed to restore.
  If they are PRIVATE, authenticate once per machine with the dotnet nuget
  update-source command (username rennyyy, password = a PAT with read:packages;
  this writes to the user-level config, never committed here).

  GitHub Actions restore instead registers the source with the built-in token
  via a workflow step (see .github/workflows/*.yml).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="github" value="https://nuget.pkg.github.com/rennnyyy/index.json" />
  </packageSources>
</configuration>
